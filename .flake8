[flake8]
# Flake8 configuration for AutoSlideGen

max-line-length = 127
max-complexity = 10

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    output

# Error codes to ignore
ignore =
    # Whitespace before ':' (conflicts with black)
    E203,
    # Line too long (handled by black)
    E501,
    # Line break before binary operator (conflicts with black)
    W503,
    # Line break after binary operator (conflicts with black)
    W504

# Error codes to always check
select =
    E,F,W,C90

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811

# Show source code for errors
show-source = True

# Show error codes in output
show-pep8 = True

# Count errors
count = True

# Show statistics
statistics = True
